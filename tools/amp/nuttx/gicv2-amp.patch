diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 9f0561ae4a9..2325fe06223 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -402,6 +402,35 @@ config ARM64_GIC_VERSION
 
 if ARM64_GIC_VERSION = 2
 
+config ARM64_GICV2_PREINITIALIZED
+	bool "GICv2 distributor initialized externally"
+	default n
+	depends on !ARCH_TRUSTZONE_SECURE && !ARM64_GICV2M
+	---help---
+		Initialize only the banked SGI/PPI registers and CPU interface when
+		firmware or another OS owns the shared distributor. Keep local SMP
+		interrupt handler registration, but do not reset SPIs or write the
+		distributor control register, including during secondary CPU startup.
+
+		The platform must ensure the owner has completed distributor setup
+		before NuttX initializes interrupts. IRQ assignment, shared-register
+		access and restart synchronization remain platform responsibilities;
+		this option alone does not isolate interrupt ownership at runtime.
+
+config ARM64_GICV2_STATIC_SPI
+	bool "GICv2 SPI configuration owned externally"
+	default n
+	depends on ARM64_GICV2_PREINITIALIZED
+	---help---
+		Keep the SPI priorities, processor targets and trigger modes set by
+		the distributor owner. Priority and trigger requests succeed only
+		when they match the current hardware configuration; changes return
+		EPERM. Affinity requests cannot change the inherited CPU targets.
+
+		SGI/PPI configuration and individual IRQ enable/disable operations
+		remain available. The platform must still restrict the IRQs assigned
+		to NuttX and coordinate restarts with the external owner.
+
 config ARM64_GIC_EOIMODE
 	bool
 	default n
diff --git a/arch/arm64/src/common/arm64_gicv2.c b/arch/arm64/src/common/arm64_gicv2.c
index 5dcb1a14fc4..b3b6450c491 100644
--- a/arch/arm64/src/common/arm64_gicv2.c
+++ b/arch/arm64/src/common/arm64_gicv2.c
@@ -773,6 +773,7 @@ static int gic_validate_dist_version(void)
 
 static void arm_gic0_initialize(void)
 {
+#ifndef CONFIG_ARM64_GICV2_PREINITIALIZED
   unsigned int nlines = arm_gic_nlines();
   unsigned int irq;
 
@@ -819,6 +820,7 @@ static void arm_gic0_initialize(void)
 #ifdef CONFIG_ARM64_GICV2M
   arm64_gic_v2m_initialize();
 #endif
+#endif /* !CONFIG_ARM64_GICV2_PREINITIALIZED */
 
 #ifdef CONFIG_SMP
   /* Attach SGI interrupt handlers. This attaches the handler to all CPUs. */
@@ -845,7 +847,9 @@ static void arm_gic0_initialize(void)
 static void arm_gic_initialize(void)
 {
   uint32_t iccicr;
+#ifndef CONFIG_ARM64_GICV2_PREINITIALIZED
   uint32_t icddcr;
+#endif
 
   /* Initialize PPIs.  The following steps need to be done by all CPUs */
 
@@ -961,14 +965,18 @@ static void arm_gic_initialize(void)
   iccicr |= (GIC_ICCICRS_ENABLEGRP0 | GIC_ICCICRS_ENABLEGRP1 |
              GIC_ICCICRS_FIQBYPDISGRP0 | GIC_ICCICRS_IRQBYPDISGRP0 |
              GIC_ICCICRS_FIQBYPDISGRP1 | GIC_ICCICRS_IRQBYPDISGRP1);
+#ifndef CONFIG_ARM64_GICV2_PREINITIALIZED
   icddcr  = (GIC_ICDDCR_ENABLEGRP0 | GIC_ICDDCR_ENABLEGRP1);
+#endif
 
 #else
   /* Enable the Group 1 interrupts and disable Group 1 bypass. */
 
   iccicr |= (GIC_ICCICRU_ENABLEGRP1 | GIC_ICCICRU_FIQBYPDISGRP1 |
              GIC_ICCICRU_IRQBYPDISGRP1);
+#ifndef CONFIG_ARM64_GICV2_PREINITIALIZED
   icddcr  = GIC_ICDDCR_ENABLE;
+#endif
 
 #endif
 
@@ -976,11 +984,13 @@ static void arm_gic_initialize(void)
 
   putreg32(iccicr, GIC_ICCICR);
 
+#ifndef CONFIG_ARM64_GICV2_PREINITIALIZED
   /* Write the ICDDCR value to enable the forwarding of interrupt by the
    * distributor.
    */
 
   putreg32(icddcr, GIC_ICDDCR);
+#endif
 }
 
 /****************************************************************************
@@ -1191,6 +1201,15 @@ int up_prioritize_irq(int irq, int priority)
 
       regaddr = GIC_ICDIPR(irq);
       regval  = getreg32(regaddr);
+#ifdef CONFIG_ARM64_GICV2_STATIC_SPI
+      if (irq >= GIC_IRQ_SPI)
+        {
+          /* Do not read-modify-write a word shared with the owner. */
+
+          return ((regval & GIC_ICDIPR_ID_MASK(irq)) ==
+                  GIC_ICDIPR_ID(irq, priority)) ? OK : -EPERM;
+        }
+#endif
       regval &= ~GIC_ICDIPR_ID_MASK(irq);
       regval |= GIC_ICDIPR_ID(irq, priority);
       putreg32(regval, regaddr);
@@ -1222,9 +1241,18 @@ void up_affinity_irq(int irq, cpu_set_t cpuset)
 
       regaddr = GIC_ICDIPTR(irq);
       regval  = getreg32(regaddr);
+#ifdef CONFIG_ARM64_GICV2_STATIC_SPI
+      if ((regval & GIC_ICDIPTR_ID_MASK(irq)) !=
+          GIC_ICDIPTR_ID(irq, cpuset))
+        {
+          sinfo("GICv2: SPI %d affinity is owned externally\n", irq);
+        }
+
+#else
       regval &= ~GIC_ICDIPTR_ID_MASK(irq);
       regval |= GIC_ICDIPTR_ID(irq, cpuset);
       putreg32(regval, regaddr);
+#endif
     }
 }
 
@@ -1252,6 +1280,13 @@ int up_set_irq_type(int irq, int mode)
   uint32_t regval;
   uint32_t intcfg;
 
+#ifdef CONFIG_ARM64_GICV2_STATIC_SPI
+  if (irq < 0 || irq >= NR_IRQS)
+    {
+      return -EINVAL;
+    }
+#endif
+
   if (!GIC_IS_SGI(irq))
     {
       if (mode == IRQ_HIGH_LEVEL || mode == IRQ_LOW_LEVEL)
@@ -1274,6 +1309,16 @@ int up_set_irq_type(int irq, int mode)
        */
 
       regval  = getreg32(regaddr);
+#ifdef CONFIG_ARM64_GICV2_STATIC_SPI
+      if (irq >= GIC_IRQ_SPI)
+        {
+          /* Only the trigger bit is writable on GICv2 SPIs. */
+
+          return ((regval & GIC_ICDICFR_ID(irq, INT_ICDICFR_EDGE)) ==
+                  GIC_ICDICFR_ID(irq, intcfg & INT_ICDICFR_EDGE)) ?
+                 OK : -EPERM;
+        }
+#endif
       regval &= ~GIC_ICDICFR_ID_MASK(irq);
       regval |= GIC_ICDICFR_ID(irq, intcfg);
       putreg32(regval, regaddr);
