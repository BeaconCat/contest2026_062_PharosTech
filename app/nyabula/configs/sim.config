# Nyabula simulator overlay for boards/sim/sim/sim/configs/lvgl_fb.
# Apply these values through menuconfig, kconfig-tweak, or merge_config.sh.
CONFIG_CONTEST2026_062_NYABULA=y
CONFIG_CONTEST2026_062_NYABULA_PRIORITY=100
CONFIG_CONTEST2026_062_NYABULA_STACKSIZE=8192
CONFIG_CONTEST2026_062_NYABULA_DYNAMIC_FONTS=y
CONFIG_CONTEST2026_062_NYABULA_FONT_ROOT="/data/nyabula/fonts"
CONFIG_CONTEST2026_062_NYABULA_GATEWAY=y
CONFIG_CONTEST2026_062_NYABULA_GATEWAY_PORT=8080
CONFIG_CONTEST2026_062_NYABULA_GATEWAY_STACKSIZE=16384
CONFIG_NET=y
CONFIG_NET_IPv4=y
CONFIG_NET_TCP=y
CONFIG_NET_USRSOCK=y
CONFIG_NET_USRSOCK_CUSTOM=y
CONFIG_NET_USRSOCK_TCP=y
CONFIG_NET_USRSOCK_PREALLOC_CONNS=16
CONFIG_NET_USRSOCK_ALLOC_CONNS=0
CONFIG_NET_USRSOCK_NPOLLWAITERS=1
CONFIG_SIM_NETUSRSOCK=y
CONFIG_MM_IOB=y
CONFIG_IOB_NBUFFERS=8
CONFIG_IOB_BUFSIZE=196
CONFIG_IOB_ALIGNMENT=4
CONFIG_IOB_SECTION=""
CONFIG_IOB_NCHAINS=0
CONFIG_IOB_THROTTLE=0
CONFIG_NET_LL_GUARDSIZE=0
CONFIG_NETUTILS_CJSON=y
CONFIG_LIBC_FLOATINGPOINT=y
CONFIG_LIB_FREETYPE=y
CONFIG_LIB_FREETYPE_MEMSIZE=0
CONFIG_LIB_FREETYPE_FONT_MODULES_TRUETYPE=y
CONFIG_LIB_FREETYPE_FONT_MODULES_SFNT=y
CONFIG_LIB_FREETYPE_AUX_MODULES_PSNAMES=y
CONFIG_LIB_FREETYPE_AUX_MODULES_PSAUX=y
CONFIG_LIB_FREETYPE_AUX_MODULES_GZIP=y
CONFIG_LIB_FREETYPE_RASTER_MODULES_SMOOTH=y
CONFIG_LV_USE_FREETYPE=y
# CONFIG_DISABLE_ENVIRON is not set
CONFIG_NSH_PROMPT_ENV="PS1"
CONFIG_FS_HOSTFS=y
CONFIG_SIM_HOSTFS=y
# CONFIG_DISABLE_MOUNTPOINT is not set
CONFIG_INIT_ARGS=""
CONFIG_INIT_ENTRYNAME="nsh"
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_SIM_FBHEIGHT=360
CONFIG_SIM_FBWIDTH=720
