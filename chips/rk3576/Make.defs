include common/Make.defs

# Rockchip RK3576 specific C source files
CHIP_CSRCS  = rk3576_boot.c rk3576_serial.c rk3576_clk_tree.c

ifeq ($(CONFIG_RK3576_GPIO),y)
CHIP_CSRCS += rk3576_gpio.c
endif

ifeq ($(CONFIG_ARCH_EARLY_PRINT),y)
CHIP_ASRCS  = rk3576_lowputc.S
endif

ifneq ($(filter y,$(CONFIG_RK3576_SDMMC) $(CONFIG_RK3576_SDIO)),)
CHIP_CSRCS += rk3576_sdmmc.c
endif

ifeq ($(CONFIG_RK3576_SV6621_TRANSPORT),y)
CHIP_CSRCS += rk3576_sv6621_transport.c
endif

ifeq ($(CONFIG_SV6621),y)
SV6621_SRCDIR = ../../../../vendor/rockchip/drivers/wireless/seekwave/sv6621
VPATH += :$(SV6621_SRCDIR)
CHIP_CSRCS += sv6621.c sv6621_netdev.c sv6621_wpa.c
CHIP_CSRCS += sv6621_command.c sv6621_core.c sv6621_firmware.c
CHIP_CSRCS += sv6621_memory.c
CHIP_CSRCS += sv6621_packet.c
CHIP_CSRCS += sv6621_protocol.c sv6621_rx.c sv6621_scan.c sv6621_service.c
CHIP_CSRCS += sv6621_transport.c sv6621_tx.c sv6621_wifi.c
endif

ifeq ($(CONFIG_RK3576_I2C),y)
CHIP_CSRCS += rk3576_i2c.c
endif

ifeq ($(CONFIG_RK3576_PWM),y)
CHIP_CSRCS += rk3576_pwm.c
endif

ifeq ($(CONFIG_RK3576_USB),y)
CHIP_CSRCS += rk3576_usb.c
endif

ifeq ($(CONFIG_RK3576_EMMC),y)
CHIP_CSRCS += rk3576_emmc.c
endif

ifeq ($(CONFIG_RK3576_DMA),y)
CHIP_CSRCS += rk3576_addrenv.c rk3576_dma.c
endif

ifeq ($(CONFIG_RK3576_DMA_ALLOC),y)
CHIP_CSRCS += rk3576_dma_alloc.c
endif

ifeq ($(CONFIG_RK3576_SAI),y)
CHIP_CSRCS += rk3576_sai.c
endif

ifeq ($(CONFIG_RK3576_FSPI),y)
CHIP_CSRCS += rk3576_fspi.c
endif

ifeq ($(CONFIG_RTC_ARCH),y)
CHIP_CSRCS += rk3576_rtc.c
endif
